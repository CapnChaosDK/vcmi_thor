<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="is.xyz.vcmi.thor" /></queries>
    <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="VCMI Builds" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AdvancedDownloadsActivity" android:exported="false" />
        <service android:name=".CandidateDownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <provider android:name=".ApkProvider" android:authorities="dev.vcmi.builds.apk" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
